Step 1 — Create a Simple Application

Inside your repo:

mkdir app
cd app

Create:

touch app.js package.json Dockerfile
app.js

Add:

const express = require("express");

const app = express();

const PORT = 3000;

app.get("/", (req, res) => {
    res.send("Application deployed using GitHub Actions CD Pipeline 🚀");
});

app.listen(PORT, () => {
    console.log(`Server running on port ${PORT}`);
});
package.json

Add:

{
  "name": "cd-demo",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "start": "node app.js"
  },
  "dependencies": {
    "express": "^5.0.0"
  }
}
Step 2 — Create Dockerfile

Inside /app/Dockerfile

Add:

FROM node:20-alpine

WORKDIR /app

COPY package*.json .

RUN npm install

COPY .

EXPOSE 3000

CMD ["npm", "start"]
